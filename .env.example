# Copy to .env for local development:  cp .env.example .env
# Never commit a real .env.

# Dev-only key. Generate a real one for any shared environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite (db.sqlite3). Set to use PostgreSQL, e.g.:
# DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
